  });

  sl.addNotes("Final slide. Score: 0.9128. preference_estimation=0.9 means our star prediction was off by 0.5 stars on the evaluation task (we predicted 4.5, ground truth 5.0). review_generation=0.9256 means the review text matched in sentiment, emotion, and topic. Total improvement of +5.14% over the hand-designed Gen 0 baseline. The three takeaways: what we built, what OpenEvolve found, and why this approach to agent design matters.");
}

// ══════════════════════════════════════════════════════════════════════════════
// WRITE FILE
// ══════════════════════════════════════════════════════════════════════════════
pres.writeFile({ fileName: "ReviewDNA_FinalPresentation.pptx" })
  .then(() => console.log("✅ Saved PPTX successfully!"))
  .catch(e => { console.error("❌ Error:", e); process.exit(1); });

